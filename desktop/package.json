{
  "name": "bst-shipment-tracker",
  "productName": "BST Shipment Tracker",
  "version": "1.0.1",
  "description": "Baniyas Spike Trading import container and shipment tracking",
  "author": "Baniyas Spike Trading Co. L.L.C.",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.baniyasspike.bsttracker",
    "productName": "BST Shipment Tracker",
    "artifactName": "BST-Shipment-Tracker-${os}-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BST Shipment Tracker"
    },
    "mac": {
      "icon": "icon.png",
      "category": "public.app-category.business",
      "identity": null
    },
    "dmg": {
      "title": "BST Shipment Tracker"
    }
  }
}
